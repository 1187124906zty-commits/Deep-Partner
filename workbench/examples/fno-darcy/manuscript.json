        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "参考文献"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "[1] Li 等. Fourier Neural Operator for Parametric Partial Differential Equations. ICLR 2021, arXiv:2010.08895。"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "[2] Li 等. Physics-Informed Neural Operator for Learning Partial Differential Equations, arXiv:2111.03794。"
          }
