      {
        "id": "delivery_summary",
        "type": "custom",
        "data": {
          "type": "code",
          "title": "交付回执生成",
          "desc": "将已经核验的成果路径、项目和处理记录整理成结构化回执；不生成新的研究结论。",
          "selected": false,
          "code_language": "python3",
          "code": "import json\ndef main(results: list, run_id: str) -> dict:\n    if not isinstance(results,list) or len(results)!=1 or not isinstance(results[0],dict):\n        raise ValueError(\"成果核验工具没有返回唯一的结构化结果\")\n    result=results[0]\n    if result.get(\"isError\") or result.get(\"error\"):\n        raise ValueError(\"成果核验未完成，请查询同一交付任务\")\n    value=result.get(\"data\")\n    if not isinstance(value,dict) or value.get(\"run_id\")!=run_id or value.get(\"status\")!=\"saved\":\n        raise ValueError(\"保存回执与当前交付任务不一致\")\n    if value.get(\"processing_history_verified\") is not True or not value.get(\"history_event_id\"):\n        raise ValueError(\"成果尚未取得原生处理记录的核验结果\")\n    artifact=value.get(\"artifact\",{}).get(\"path\")\n    if not artifact:raise ValueError(\"保存回执缺少成果路径\")\n    return {\"receipt\":json.dumps(value,ensure_ascii=False),\"artifact\":artifact,\n        \"project_id\":value[\"project_id\"],\"history_event_id\":str(value[\"history_event_id\"]),\n        \"summary\":json.dumps(value.get(\"delivery_summary\",{}),ensure_ascii=False)}\n",
          "variables": [
            {
              "variable": "results",
              "value_selector": [
                "delivery_verify",
                "json"
              ]
            },
