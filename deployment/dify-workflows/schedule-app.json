        "id": "inspect_result",
        "type": "custom",
        "data": {
          "type": "code",
          "title": "提取已核验状态",
          "desc": "",
          "selected": false,
          "code_language": "python3",
          "code": "import json\ndef main(results: list) -> dict:\n    if not isinstance(results,list) or len(results)!=1:raise ValueError(\"工具没有返回唯一结果\")\n    value=results[0]\n    if value.get(\"isError\"):raise ValueError(\"工具执行失败，请检查节点原始输出\")\n    for _ in range(4):\n        if isinstance(value,dict) and (\"outcome\" in value or \"needs_attention\" in value):break\n        value=value.get(\"data\") if isinstance(value,dict) else None\n    if not isinstance(value,dict):raise ValueError(\"工具缺少结构化业务结果\")\n    flag=value.get(\"ready\") if \"outcome\" in value else not value.get(\"needs_attention\",True)\n    return {\"ready\":bool(flag),\"detail\":json.dumps(value,ensure_ascii=False)}\n",
          "variables": [
            {
              "variable": "results",
              "value_selector": [
                "inspect",
                "json"
              ]
            }
          ],
