      {
        "id": "accepted_intent",
        "type": "custom",
        "data": {
          "type": "code",
          "title": "核对阶段受理回执",
          "desc": "",
          "selected": false,
          "code_language": "python3",
          "code": "import json\ndef main(status_code: int, body: str) -> dict:\n    try: value = json.loads(body)\n    except (ValueError, TypeError): value = None\n    if not 200 <= status_code < 300:\n        detail = value.get(\"detail\", \"请求未被接受\") if isinstance(value, dict) else \"响应不是有效JSON\"\n        raise ValueError(\"HTTP \" + str(status_code) + \": \" + str(detail)[:600])\n    if not isinstance(value, dict): raise ValueError(\"接口缺少结构化回执\")\n    return {\"receipt\": json.dumps(value, ensure_ascii=False)}\n\ncheck_http = main\ndef main(status_code: int, body: str, run_id: str, stage: str) -> dict:\n    receipt = check_http(status_code, body)\n    value = json.loads(receipt[\"receipt\"])\n    if value.get(\"accepted\") is not True:\n        raise ValueError(\"写作阶段未被接受，保留当前任务等待核对\")\n    if value.get(\"run_id\", run_id) != run_id:\n        raise ValueError(\"写作回执不属于当前任务\")\n    if value.get(\"stage\", stage) != stage and value.get(\"status\") != \"already_advanced\":\n        raise ValueError(\"写作回执阶段不一致\")\n    return receipt\n",
          "variables": [
            {
              "variable": "status_code",
              "value_selector": [
                "intent",
                "status_code"
              ]
            },
            {
              "variable": "body",
              "value_selector": [
                "intent",
                "body"
              ]
            },
            {
              "variable": "run_id",
              "value_selector": [
                "start",
                "run_id"
              ]
            },
            {
              "variable": "stage",
              "value_selector": [
                "start",
                "stage"
              ]
            }
          ],
          "outputs": {
            "receipt": {
              "type": "string",
              "children": null
            }
          }
        },
