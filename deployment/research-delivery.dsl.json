{
  "version": "0.7.0",
  "kind": "app",
  "dependencies": [],
  "app": {
    "name": "研究工作台 · 技能成果交付",
    "description": "沿用 DeepTutor 会话和当前工作台技能，校验项目、保留版本、回读后返回成果回执。",
    "mode": "workflow",
    "icon": "📚",
    "icon_background": "#E5F0E8",
    "use_icon_as_answer_icon": false
  },
  "workflow": {
    "conversation_variables": [],
    "environment_variables": [],
    "features": {
      "file_upload": {
        "enabled": false
      },
      "retriever_resource": {
        "enabled": false
      },
      "sensitive_word_avoidance": {
        "enabled": false
      },
      "speech_to_text": {
        "enabled": false
      },
      "text_to_speech": {
        "enabled": false
      },
      "suggested_questions": [],
      "suggested_questions_after_answer": {
        "enabled": false
      },
      "opening_statement": ""
    },
    "graph": {
      "nodes": [
        {
          "id": "start",
          "type": "custom",
          "width": 244,
          "height": 100,
          "position": {
            "x": 30,
            "y": 100
          },
          "positionAbsolute": {
            "x": 30,
            "y": 100
          },
          "sourcePosition": "right",
          "targetPosition": "left",
          "selected": false,
          "data": {
            "type": "start",
            "title": "接收会话成果票据",
            "desc": "",
            "variables": [
              {
                "variable": "run_id",
                "label": "run_id",
                "type": "text-input",
                "required": true,
                "max_length": 200,
                "options": []
              },
              {
                "variable": "ticket",
                "label": "ticket",
                "type": "text-input",
                "required": true,
                "max_length": 200,
                "options": []
              }
            ]
          }
        },
        {
          "id": "prepare",
          "type": "custom",
          "width": 244,
          "height": 100,
          "position": {
            "x": 340,
            "y": 100
          },
          "positionAbsolute": {
            "x": 340,
            "y": 100
          },
          "sourcePosition": "right",
          "targetPosition": "left",
          "selected": false,
          "data": {
            "type": "http-request",
            "title": "核对当前项目与技能规范",
            "desc": "",
            "method": "get",
            "url": "https://tutor.example.invalid/research/dify/internal/runs/{{#start.run_id#}}/context",
            "authorization": {
              "type": "no-auth"
            },
            "headers": "X-Run-Ticket:{{#start.ticket#}}",
            "params": "",
            "body": {
              "type": "none",
              "data": []
            },
            "timeout": {
              "connect": 10,
              "read": 90,
              "write": 30
            },
            "retry_config": {
              "retry_enabled": false,
              "max_retries": 0,
              "retry_interval": 1000
            }
          }
        },
        {
          "id": "commit",
          "type": "custom",
          "width": 244,
          "height": 100,
          "position": {
            "x": 650,
            "y": 100
          },
          "positionAbsolute": {
            "x": 650,
            "y": 100
          },
          "sourcePosition": "right",
          "targetPosition": "left",
          "selected": false,
          "data": {
            "type": "http-request",
            "title": "写回成果、回读并记录回执",
            "desc": "",
            "method": "post",
            "url": "https://tutor.example.invalid/research/dify/internal/runs/{{#start.run_id#}}/commit",
            "authorization": {
              "type": "no-auth"
            },
            "headers": "X-Run-Ticket:{{#start.ticket#}}",
            "params": "",
            "body": {
              "type": "none",
              "data": []
            },
            "timeout": {
              "connect": 10,
              "read": 90,
              "write": 30
            },
            "retry_config": {
              "retry_enabled": false,
              "max_retries": 0,
              "retry_interval": 1000
            }
          }
        },
        {
          "id": "end",
          "type": "custom",
          "width": 244,
          "height": 100,
          "position": {
            "x": 960,
            "y": 100
          },
          "positionAbsolute": {
            "x": 960,
            "y": 100
          },
          "sourcePosition": "right",
          "targetPosition": "left",
          "selected": false,
          "data": {
            "type": "end",
            "title": "返回实际保存回执",
            "desc": "",
            "outputs": [
              {
                "variable": "receipt",
                "value_selector": [
                  "commit",
                  "body"
                ],
                "value_type": "string"
              },
              {
                "variable": "status_code",
                "value_selector": [
                  "commit",
                  "status_code"
                ],
                "value_type": "number"
              }
            ]
          }
        }
      ],
      "edges": [
        {
          "id": "start-prepare",
          "source": "start",
          "target": "prepare",
          "sourceHandle": "source",
          "targetHandle": "target",
          "type": "custom",
          "zIndex": 0,
          "data": {
            "sourceType": "start",
            "targetType": "http-request",
            "isInIteration": false,
            "isInLoop": false
          }
        },
        {
          "id": "prepare-commit",
          "source": "prepare",
          "target": "commit",
          "sourceHandle": "source",
          "targetHandle": "target",
          "type": "custom",
          "zIndex": 0,
          "data": {
            "sourceType": "http-request",
            "targetType": "http-request",
            "isInIteration": false,
            "isInLoop": false
          }
        },
        {
          "id": "commit-end",
          "source": "commit",
          "target": "end",
          "sourceHandle": "source",
          "targetHandle": "target",
          "type": "custom",
          "zIndex": 0,
          "data": {
            "sourceType": "http-request",
            "targetType": "end",
            "isInIteration": false,
            "isInLoop": false
          }
        }
      ],
      "viewport": {
        "x": 0,
        "y": 0,
        "zoom": 0.8
      }
    }
  }
}
